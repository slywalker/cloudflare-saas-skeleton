{
  "name": "cloudflare-saas-skeleton",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy --config dist/cloudflare_saas_skeleton/wrangler.json --minify",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB_CONTROL --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB_CONTROL --remote",
    "setup:local": "node scripts/setup-local.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "reset:local": "node scripts/reset-local.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-table": "^9.1.2",
    "better-auth": "^1.6.27",
    "better-auth-cloudflare": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.3",
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/runner": "3.2.7",
    "@vitest/snapshot": "3.2.7",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "vitest": "3.2.7",
    "wrangler": "^4.121.0"
  }
}
