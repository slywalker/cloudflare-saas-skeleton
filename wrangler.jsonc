/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-saas-skeleton",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-11",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * workers.dev サブドメインでの公開を無効化する。テナントのHostヘッダによる
	 * ルーティングは本番ドメインでのDNS/ルート制御を前提としており、
	 * workers.dev 経由のアクセスは Host 偽装によるテナント誤解決の余地を生むため。
	 */
	"workers_dev": false,
	/**
	 * このWorkerが応答するホスト名パターン。ルートドメイン(apex/www)と
	 * 全サブドメイン(テナント)をカバーする。実際のドメインに置き換えること。
	 * (例: "example.com/*", "*.example.com/*")
	 */
	"routes": [
		// { "pattern": "example.com/*", "zone_name": "example.com" },
		// { "pattern": "*.example.com/*", "zone_name": "example.com" }
	],
	/**
	 * 制御プレーン D1 (中央データベース: tenants / better-auth 各テーブル)。
	 * database_id は `wrangler d1 create <name>` 実行後に発行される値へ置き換えること。
	 */
	"d1_databases": [
		{
			"binding": "DB_CONTROL",
			"database_name": "saas-control",
			"database_id": "TODO",
			"migrations_dir": "migrations"
		},
		/**
		 * ローカル開発専用: テナントDBの代わりに全テナントで共有するD1。
		 * 本番ではテナント毎に動的作成したD1をREST API経由で使う (src/lib/tenant-db.ts)
		 * ため、この静的バインディングは実運用では使わない
		 * (database_id はダミーのままでよく、`wrangler d1 create` する必要はない)。
		 * ローカルでは CLOUDFLARE_API_TOKEN が未設定の場合に自動でこちらへ
		 * フォールバックする (src/lib/tenant-db-factory.ts 参照)。
		 */
		{
			"binding": "DB_TENANT_LOCAL",
			"database_name": "saas-tenant-local",
			"database_id": "local-dev-only"
		}
	],
	/**
	 * セッション/テナント台帳キャッシュ用 KV。
	 * id は `wrangler kv namespace create <name>` 実行後に発行される値へ置き換えること。
	 */
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "TODO"
		}
	],
	/**
	 * 非機密の環境変数。機密情報 (CLOUDFLARE_API_TOKEN, BETTER_AUTH_SECRET 等) は
	 * `wrangler secret put <name>` で設定し、ここには書かない。
	 *
	 * BETTER_AUTH_URL はここでは本番想定のプレースホルダとし、ローカル開発時の
	 * 値 (例: http://localhost:5173) は .dev.vars に置く (.dev.vars.example 参照)。
	 * .dev.vars の値は `wrangler dev` 実行時にこの vars を上書きする。
	 */
	"vars": {
		"APP_ROOT_DOMAIN": "example.com",
		"BETTER_AUTH_URL": "https://example.com"
	},
	/**
	 * テナントDB群へのマイグレーション追随バッチ (src/workflows/tenant-migrations.ts)。
	 * `migrations-tenant/*.sql` の未適用分を全テナントD1へ順に適用する。
	 * 手動起動のみを想定 (HTTPルートは無い): `wrangler workflows trigger tenant-migrations`
	 */
	"workflows": [
		{
			"name": "tenant-migrations",
			"binding": "TENANT_MIGRATIONS",
			"class_name": "TenantMigrationsWorkflow"
		}
	],
	/**
	 * ジョブキュー基盤 (src/shared/jobs.ts / src/lib/jobs.ts / src/queues/consumer.ts)。
	 * Stripe / Resend 等の外部API呼び出しを API ハンドラから直接行わず、必ず
	 * このキュー経由にする (CLAUDE.md「約束事」)。本番デプロイ前に以下のコマンドで
	 * キューを作成しておくこと (ローカル dev はキュー作成不要、miniflare がシミュレート):
	 *   wrangler queues create jobs
	 *   wrangler queues create jobs-dlq
	 */
	"queues": {
		"producers": [
			{
				"binding": "QUEUE_JOBS",
				"queue": "jobs"
			}
		],
		"consumers": [
			{
				"queue": "jobs",
				"max_batch_size": 10,
				"max_retries": 3,
				// リトライ間隔 (秒)。0 (既定) だと失敗直後に即再送されてしまい、
				// 外部API側の一時障害・レート制限を悪化させかねない (Stripe/Resend
				// への再試行が短時間に連発する)。60秒空けて様子を見る。
				"retry_delay": 60,
				// 同時に処理する consumer インスタンス数の上限。既定では自動スケール
				// するが、Resend/Stripe 等の外部APIにはレート制限があるため、
				// 一度に叩きすぎないよう控えめな値に固定する。
				"max_concurrency": 5,
				// リトライを使い切ったメッセージの退避先。溜まったメッセージの監視
				// (アラート等) は未実装 (今後の課題)。
				"dead_letter_queue": "jobs-dlq"
			}
		]
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}